---
import { Image } from 'astro:assets';
import IconPin from './icons/IconPin.astro';
import metlife from '../assets/seguros/metlife.png';
import latino from '../assets/seguros/latino.png';
import planSeguro from '../assets/seguros/plan-seguro.png';
import allianz from '../assets/seguros/allianz.png';
import atlas from '../assets/seguros/atlas.png';

const aseguradoras = [
  { name: 'MetLife', src: metlife },
  { name: 'Latino Seguros', src: latino },
  { name: 'Plan Seguro', src: planSeguro },
  { name: 'Allianz', src: allianz },
  { name: 'Seguros Atlas', src: atlas },
];
---
<section class="section">
  <div class="faq">
    <div class="eyebrow">Preguntas frecuentes</div>
    <details>
      <summary>¿Qué seguros de gastos médicos aceptan?</summary>
      <p>Aceptamos pólizas de MetLife, Latino Seguros, Plan Seguro, Allianz, Seguros Atlas, entre otros. Emitimos la documentación requerida para tu reembolso.</p>
      <div class="insurer-logos">
        {aseguradoras.map((a) => (
          <div class="insurer-logo"><Image src={a.src} alt={a.name} height={64} loading="lazy" /></div>
        ))}
      </div>
    </details>
    <details>
      <summary>¿Dónde se encuentra ubicado el consultorio?</summary>
      <p>En el Hospital Ángeles Lindavista, Consultorio 315.</p>
      <div class="location">
        <a class="address" href="https://maps.google.com/?q=Hospital+Angeles+Lindavista+Consultorio+315" target="_blank" rel="noopener">
          <span class="pin"><IconPin /></span>
          <span class="address-text">
            <strong>Hospital Ángeles Lindavista · Consultorio 315</strong>
            <small>Rio Bamba 639, Lindavista, Gustavo A. Madero, CDMX</small>
          </span>
          <span class="go">Cómo llegar ↗</span>
        </a>
        <div class="map">
          <iframe
            title="Ubicación de Hospital Ángeles Lindavista en Google Maps"
            src="https://maps.google.com/maps?q=Hospital+Angeles+Lindavista+Rio+Bamba+639+Lindavista+CDMX&z=16&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </details>
    <details>
      <summary>¿Cómo confirman mi cita agendada?</summary>
      <p>Al seleccionar tu horario en esta página, el equipo médico se pondrá en contacto directo contigo vía WhatsApp para confirmar los detalles.</p>
    </details>
  </div>
</section>

<style>
  .faq { max-width: 820px; margin: 0 auto; }
  .faq .eyebrow { justify-content: center; }
  details { background: var(--white); border: 1px solid var(--line); border-radius: 0.75rem; margin-bottom: 0.9rem; padding: 1.1rem 1.4rem; transition: box-shadow 0.2s; }
  details[open] { box-shadow: var(--shadow); }
  summary { font-weight: 600; font-size: 0.95rem; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; font-size: 1.3rem; line-height: 1; color: var(--slate); }
  details[open] summary::after { content: "−"; }
  details p { margin-top: 0.8rem; font-size: 0.9rem; color: var(--muted); }
  .insurer-logos { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1rem; }
  .insurer-logo { height: 44px; padding: 0.4rem 0.8rem; display: flex; align-items: center; background: var(--white); border: 1px solid var(--line); border-radius: 0.6rem; }
  .insurer-logo :global(img) { display: block; height: 100%; width: auto; max-width: 90px; object-fit: contain; }
  .location { margin-top: 1.1rem; border-radius: 1rem; overflow: hidden; border: 1px solid var(--line); box-shadow: var(--shadow); background: var(--white); }
  .address { display: flex; align-items: center; gap: 0.9rem; padding: 1rem 1.2rem; background: var(--navy); color: var(--white); text-decoration: none; transition: background 0.25s; }
  .address:hover { background: var(--navy-mid); }
  .pin { flex: none; width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,0.12); display: grid; place-items: center; }
  .pin :global(svg) { width: 20px; height: 20px; color: var(--white); }
  .address-text { flex: 1; min-width: 0; }
  .address-text strong { display: block; font-size: 0.9rem; font-weight: 700; }
  .address-text small { display: block; font-size: 0.78rem; color: #c3d0e0; line-height: 1.4; margin-top: 0.1rem; }
  .go { flex: none; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.5rem 0.9rem; border: 1px solid rgba(255,255,255,0.4); border-radius: 2rem; transition: background 0.25s, color 0.25s; }
  .address:hover .go { background: var(--white); color: var(--navy); }
  .map iframe { display: block; width: 100%; height: 320px; border: 0; }

  @media (max-width: 600px) {
    .go { display: none; }
    .map iframe { height: 260px; }
  }
</style>
