<section id="agendar" class="booking">
  <div class="booking-box">
    <div class="eyebrow">Agendar consulta</div>

    <div class="scheduler" id="scheduler">
      <p class="step-label">1. Elige fecha y horario</p>
      <div id="slotsState" class="slots-state" role="status" aria-live="polite">Cargando horarios disponibles...</div>
      <div id="slotsPicker" hidden>
        <p class="mini-label">Mes</p>
        <div class="months" id="months" role="tablist"></div>
        <p class="mini-label">Día</p>
        <div class="days" id="days"></div>
        <p class="mini-label">Horario</p>
        <div class="times" id="times"></div>
      </div>
      <p id="selectionSummary" class="summary" hidden></p>
    </div>

    <form id="appointmentForm" novalidate>
      <fieldset id="formFields" disabled>
        <p class="step-label">2. Tus datos</p>
        <div class="field">
          <label for="nombre">Nombre(s)</label>
          <input type="text" id="nombre" class="control" placeholder="Ej. Juan" autocomplete="given-name" required>
        </div>
        <div class="field">
          <label for="apellidos">Apellidos</label>
          <input type="text" id="apellidos" class="control" placeholder="Ej. Pérez López" autocomplete="family-name" required>
        </div>
        <div class="field">
          <label for="telefono">Teléfono de contacto (WhatsApp)</label>
          <input type="tel" id="telefono" class="control" placeholder="5512345678" inputmode="numeric" maxlength="10" autocomplete="tel-national" required>
        </div>
        <label class="consent">
          <input type="checkbox" id="privacidad" required />
          <span>Acepto el <a href="#privacidad-modal" id="openPrivacy">Aviso de Privacidad</a></span>
        </label>
        <button type="submit" class="submit" disabled>Solicitar cita médica</button>
      </fieldset>
    </form>
    <p id="formStatus" class="form-status" role="status" aria-live="polite"></p>
  </div>
</section>

<dialog id="privacidad-modal" class="privacy">
  <button type="button" class="privacy-close" aria-label="Cerrar">×</button>
  <h3>Aviso de Privacidad</h3>
  <div class="privacy-body">
    <p>El Dr. Daniel Ibarra Alva, con domicilio en Hospital Ángeles Lindavista, Consultorio 315, Río Bamba 639, Lindavista, Gustavo A. Madero, CDMX, es responsable del tratamiento de sus datos personales, de conformidad con la Ley Federal de Protección de Datos Personales en Posesión de los Particulares.</p>
    <p><strong>Datos que recabamos:</strong> nombre completo, teléfono de contacto y fecha y horario de interés para su consulta.</p>
    <p><strong>Finalidades:</strong> agendar y confirmar su cita médica, contactarlo por teléfono o WhatsApp y dar seguimiento a su solicitud de atención.</p>
    <p><strong>Transferencias:</strong> sus datos no serán compartidos con terceros, salvo obligación legal o para las finalidades antes descritas. Se almacenan en herramientas de gestión de citas con medidas de seguridad razonables.</p>
    <p><strong>Derechos ARCO:</strong> usted puede acceder, rectificar, cancelar u oponerse al tratamiento de sus datos, o revocar su consentimiento, enviando su solicitud por WhatsApp al 55 6155 5254 o directamente en el consultorio.</p>
    <p>Al marcar la casilla y enviar el formulario, usted otorga su consentimiento para el tratamiento de sus datos conforme a este aviso. Cualquier cambio será publicado en este sitio web.</p>
  </div>
</dialog>

<style>
  .booking { background: linear-gradient(135deg, var(--navy) 0%, var(--navy-deep) 100%); color: var(--white); padding: 4.5rem 1.5rem; clip-path: polygon(0 24px, 100% 0, 100% 100%, 0 100%); margin-top: -24px; }
  .booking-box { max-width: 620px; margin: 0 auto; }
  .booking .eyebrow { color: #c3d0e0; justify-content: center; }
  .booking .eyebrow::before { background: #c3d0e0; }

  .step-label { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--white); margin-bottom: 1rem; }
  .mini-label { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #c3d0e0; margin: 1rem 0 0.5rem; }
  .scheduler { margin-bottom: 2rem; }
  .slots-state { padding: 1rem; border-radius: 0.5rem; border: 1px dashed rgba(255,255,255,0.3); text-align: center; font-size: 0.9rem; color: #c3d0e0; }
  .slots-state.error { border-color: rgba(239, 68, 68, 0.6); color: #fecaca; }
  .slots-state[hidden], .summary[hidden] { display: none; }
  .slots-state :global(button) { margin-left: 0.6rem; padding: 0.3rem 0.8rem; border-radius: 2rem; border: 1px solid rgba(255,255,255,0.5); background: none; color: var(--white); font: inherit; font-size: 0.8rem; cursor: pointer; }
  .months, .days, .times { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .scheduler :global(.chip) {
    border: 1px solid rgba(255,255,255,0.22); background: rgba(255,255,255,0.08); color: var(--white);
    border-radius: 0.5rem; padding: 0.55rem 0.95rem; font: inherit; font-size: 0.88rem; font-weight: 600; cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s;
  }
  .scheduler :global(.chip:hover) { background: rgba(255,255,255,0.18); transform: translateY(-1px); }
  .scheduler :global(.chip.active) { background: var(--white); color: var(--navy); border-color: var(--white); }
  .scheduler :global(.chip.selected) { background: #4da3ff; color: var(--navy-deep); border-color: #4da3ff; }
  .scheduler :global(.day) { display: flex; flex-direction: column; align-items: center; min-width: 58px; padding: 0.5rem 0.6rem; line-height: 1.2; }
  .scheduler :global(.day small) { font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 600; opacity: 0.85; }
  .scheduler :global(.day strong) { font-size: 1.15rem; }
  .scheduler :global(.hint) { font-size: 0.85rem; color: #c3d0e0; }
  .summary { margin-top: 1.2rem; padding: 0.85rem 1rem; border-radius: 0.5rem; background: rgba(77, 163, 255, 0.15); border: 1px solid rgba(77, 163, 255, 0.6); color: #cfe6ff; font-size: 0.9rem; font-weight: 600; text-align: center; }

  #formFields { border: 0; padding: 0; margin: 0; min-width: 0; transition: opacity 0.3s; }
  #formFields:disabled { opacity: 0.4; pointer-events: none; }

  .field { margin-bottom: 1.2rem; }
  .field label { display: block; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #c3d0e0; margin-bottom: 0.45rem; }
  .control {
    width: 100%; padding: 0.9rem 1rem; font: inherit; font-size: 0.95rem;
    background: rgba(255,255,255,0.08); color: var(--white);
    border: 1px solid rgba(255,255,255,0.22); border-radius: 0.5rem; outline: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .control::placeholder { color: rgba(255,255,255,0.45); }
  .control:focus { border-color: var(--white); background: rgba(255,255,255,0.14); }
  .control.invalid { border-color: #f87171; background: rgba(239, 68, 68, 0.12); }
  .submit {
    width: 100%; margin-top: 0.5rem; padding: 1rem; border: 0; cursor: pointer;
    background: var(--white); color: var(--navy); font: inherit; font-weight: 700; letter-spacing: 0.06em; border-radius: 0.5rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .submit:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(0,0,0,0.3); }
  .consent { display: flex; align-items: flex-start; gap: 0.6rem; margin-top: 0.4rem; font-size: 0.85rem; color: #c3d0e0; cursor: pointer; }
  .consent input { margin-top: 0.25rem; width: 16px; height: 16px; accent-color: #4da3ff; flex: none; cursor: pointer; }
  .consent a { color: var(--white); font-weight: 600; text-decoration: underline; }
  .privacy { border: 0; border-radius: 1rem; padding: 2rem; max-width: 600px; width: 92vw; max-height: 85vh; margin: auto; background: var(--white); color: var(--navy); box-shadow: 0 30px 60px rgba(0,0,0,0.5); position: fixed; }
  .privacy::backdrop { background: rgba(15, 27, 45, 0.8); backdrop-filter: blur(4px); }
  .privacy h3 { font-size: 1.15rem; margin-bottom: 1rem; padding-right: 2rem; }
  .privacy-body { max-height: calc(85vh - 8rem); overflow-y: auto; padding-right: 0.5rem; }
  .privacy-body p { font-size: 0.85rem; line-height: 1.65; color: var(--slate); margin-bottom: 0.8rem; }
  .privacy-close { position: absolute; top: 0.8rem; right: 0.9rem; width: 34px; height: 34px; border-radius: 50%; border: 0; cursor: pointer; background: var(--panel); color: var(--navy); font-size: 1.4rem; line-height: 1; }
  .submit:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }
  .form-status { display: none; margin-top: 1.2rem; padding: 0.9rem 1rem; border-radius: 0.5rem; font-size: 0.9rem; font-weight: 600; text-align: center; }
  .form-status.ok { display: block; background: rgba(37, 211, 102, 0.15); border: 1px solid rgba(37, 211, 102, 0.6); color: #b8f5d0; }
  .form-status.error { display: block; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.6); color: #fecaca; }
</style>

<script>
  const WEBHOOK_URL = 'https://script.google.com/macros/s/AKfycby1VAGyKi_ZC1qAtcGaCy3DgH8rIavR_S5A3Vm-BOKnSKwVgQt6p22q2wIYaYoZkF_a/exec';
  const WHATSAPP_NUMBER = '525561555254';
  const MESES = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
  const DIAS = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];

  type Slot = { fecha: string; hora: string; raw: string };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>('appointmentForm');
  const fields = $<HTMLFieldSetElement>('formFields');
  const submitBtn = form.querySelector('.submit') as HTMLButtonElement;
  const status = $('formStatus');
  const originalText = submitBtn.textContent ?? '';
  const privacyCheck = $<HTMLInputElement>('privacidad');
  const nombreInput = $<HTMLInputElement>('nombre');
  const apellidosInput = $<HTMLInputElement>('apellidos');
  const telInput = $<HTMLInputElement>('telefono');
  const slotsState = $('slotsState');
  const slotsPicker = $('slotsPicker');
  const monthsEl = $('months');
  const daysEl = $('days');
  const timesEl = $('times');
  const summary = $('selectionSummary');

  let slots: Slot[] = [];
  let selected: Slot | null = null;
  let activeMonth = '';
  let activeDay = '';

  const parseFecha = (f: string) => { const [y, m, d] = f.split('-').map(Number); return { y, m, d, date: new Date(y, m - 1, d) }; };
  const fmtLong = (f: string) => { const { y, m, d } = parseFecha(f); return `${d} de ${MESES[m - 1]} de ${y}`; };
  const fmt12 = (h: string) => {
    const [hh, mm] = h.split(':').map(Number);
    return `${String(hh % 12 || 12).padStart(2, '0')}:${String(mm).padStart(2, '0')} ${hh >= 12 ? 'PM' : 'AM'}`;
  };
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls: string, html: string, onClick?: () => void) => {
    const e = document.createElement(tag);
    e.className = cls;
    e.innerHTML = html;
    if (tag === 'button') (e as HTMLButtonElement).type = 'button';
    if (onClick) e.addEventListener('click', onClick);
    return e;
  };

  const syncSubmit = () => { submitBtn.disabled = !privacyCheck.checked; };
  const enableForm = (on: boolean) => { fields.disabled = !on; syncSubmit(); };
  privacyCheck.addEventListener('change', syncSubmit);
  form.addEventListener('reset', () => setTimeout(syncSubmit));
  syncSubmit();

  telInput.addEventListener('input', () => { telInput.value = telInput.value.replace(/\D/g, '').slice(0, 10); });
  [nombreInput, apellidosInput, telInput].forEach((i) => i.addEventListener('input', () => i.classList.remove('invalid')));

  const showStatus = (text: string, ok: boolean) => {
    status.textContent = text;
    status.className = 'form-status ' + (ok ? 'ok' : 'error');
  };

  const monthKey = (f: string) => f.slice(0, 7);

  const render = () => {
    const months = [...new Set(slots.map((s) => monthKey(s.fecha)))];
    monthsEl.innerHTML = '';
    months.forEach((mk) => {
      const [y, m] = mk.split('-').map(Number);
      const b = el('button', 'chip' + (mk === activeMonth ? ' active' : ''), `${MESES[m - 1]} ${y}`, () => {
        activeMonth = mk;
        activeDay = selected && monthKey(selected.fecha) === mk ? selected.fecha : '';
        render();
      });
      b.setAttribute('role', 'tab');
      b.setAttribute('aria-selected', String(mk === activeMonth));
      monthsEl.appendChild(b);
    });

    daysEl.innerHTML = '';
    const days = [...new Set(slots.filter((s) => monthKey(s.fecha) === activeMonth).map((s) => s.fecha))];
    days.forEach((f) => {
      const { d, date } = parseFecha(f);
      const cls = 'chip day' + (f === activeDay ? ' active' : '') + (selected?.fecha === f ? ' selected' : '');
      daysEl.appendChild(el('button', cls, `<small>${DIAS[date.getDay()]}</small><strong>${d}</strong>`, () => { activeDay = f; render(); }));
    });

    timesEl.innerHTML = '';
    if (!activeDay) {
      timesEl.appendChild(el('span', 'hint', 'Selecciona un día para ver los horarios.'));
    } else {
      slots.filter((s) => s.fecha === activeDay).forEach((s) => {
        const isSel = selected?.fecha === s.fecha && selected.hora === s.hora;
        timesEl.appendChild(el('button', 'chip' + (isSel ? ' selected' : ''), fmt12(s.hora), () => {
          selected = s;
          enableForm(true);
          render();
        }));
      });
    }

    if (selected) {
      summary.textContent = `Cita seleccionada: ${fmtLong(selected.fecha)} · ${fmt12(selected.hora)}`;
      summary.hidden = false;
    } else {
      summary.hidden = true;
    }
  };

  const LMT_OFFSET_SECONDS = 6 * 3600 + 36 * 60 + 36;
  const normFecha = (v: unknown) => String(v ?? '').trim().slice(0, 10);
  const normHora = (v: unknown) => {
    const raw = String(v ?? '').trim();
    if (raw.startsWith('1899-12-30T')) {
      const d = new Date(raw);
      if (isNaN(d.getTime())) return '';
      const secs = (((d.getUTCHours() * 3600 + d.getUTCMinutes() * 60 + d.getUTCSeconds() - LMT_OFFSET_SECONDS) % 86400) + 86400) % 86400;
      const mins = Math.round(secs / 60) % 1440;
      return `${String(Math.floor(mins / 60)).padStart(2, '0')}:${String(mins % 60).padStart(2, '0')}`;
    }
    const legacy = raw.match(/1899\s+(\d{1,2}):(\d{2}):\d{2}/);
    if (legacy) return `${legacy[1].padStart(2, '0')}:${legacy[2]}`;
    const m = raw.match(/^(\d{1,2}):(\d{2})/);
    return m ? `${m[1].padStart(2, '0')}:${m[2]}` : '';
  };

  const normalize = (data: unknown): Slot[] => {
    const arr = Array.isArray(data) ? data : (data as { horarios?: unknown })?.horarios;
    if (!Array.isArray(arr)) throw new Error('Formato de respuesta inválido');
    const now = new Date();
    const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    const nowHM = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
    const seen = new Set<string>();
    return arr
      .filter((s) => s)
      .map((s) => ({ fecha: normFecha(s.fecha), hora: normHora(s.hora), raw: String(s.hora) }))
      .filter((s) => /^\d{4}-\d{2}-\d{2}$/.test(s.fecha) && /^\d{2}:\d{2}$/.test(s.hora) && s.fecha >= today && (s.fecha > today || s.hora > nowHM))
      .filter((s) => { const k = s.fecha + s.hora; if (seen.has(k)) return false; seen.add(k); return true; })
      .sort((a, b) => (a.fecha + a.hora).localeCompare(b.fecha + b.hora));
  };

  const loadSlots = async () => {
    slotsState.hidden = false;
    slotsState.className = 'slots-state';
    slotsState.textContent = 'Cargando horarios disponibles...';
    slotsPicker.hidden = true;
    try {
      const res = await fetch(`${WEBHOOK_URL}?t=${Date.now()}`);
      slots = normalize(await res.json());
      if (!slots.length) {
        slotsState.textContent = 'Por el momento no hay horarios disponibles. Contáctanos por WhatsApp para agendar.';
        return;
      }
      if (selected && !slots.some((s) => s.fecha === selected!.fecha && s.hora === selected!.hora)) {
        selected = null;
        enableForm(false);
      }
      if (!activeMonth || !slots.some((s) => monthKey(s.fecha) === activeMonth)) {
        activeMonth = monthKey(slots[0].fecha);
        activeDay = '';
      }
      slotsState.hidden = true;
      slotsPicker.hidden = false;
      render();
    } catch (err) {
      console.error(err);
      slotsState.className = 'slots-state error';
      slotsState.innerHTML = 'No se pudieron cargar los horarios.';
      slotsState.appendChild(el('button', '', 'Reintentar', loadSlots));
    }
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.className = 'form-status';
    status.textContent = '';
    const nombre = nombreInput.value.trim();
    const apellidos = apellidosInput.value.trim();
    const tel = telInput.value.trim();
    const errores: string[] = [];
    const invalido = (i: HTMLElement, msg: string) => { errores.push('- ' + msg); i.classList.add('invalid'); };
    [nombreInput, apellidosInput, telInput].forEach((i) => i.classList.remove('invalid'));
    if (!nombre) invalido(nombreInput, 'Ingresa tu nombre(s).');
    if (!apellidos) invalido(apellidosInput, 'Ingresa tus apellidos.');
    if (!tel) invalido(telInput, 'Ingresa tu teléfono de contacto.');
    else if (!/^\d{10}$/.test(tel)) invalido(telInput, 'El teléfono debe contener exactamente 10 dígitos numéricos.');
    if (!selected) errores.push('- Selecciona una fecha y un horario disponible.');
    if (!privacyCheck.checked) errores.push('- Acepta el Aviso de Privacidad.');
    if (errores.length || !selected) {
      alert('Por favor corrige lo siguiente:\n' + errores.join('\n'));
      return;
    }
    const cita = selected;
    const horario = `${fmtLong(cita.fecha)} ${fmt12(cita.hora)}`;
    fields.disabled = true;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Reservando horario...';
    showStatus('Reservando horario...', true);
    const wa = window.open('', '_blank');
    let reservado = false;
    try {
      const res = await fetch(WEBHOOK_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({ fecha: cita.fecha, hora: cita.raw, horaCita: cita.hora, nombre, apellidos, telefono: tel, horario }),
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json().catch(() => null);
      if (data && (data.ok === false || data.success === false || data.status === 'error' || data.error)) throw new Error(data.error || data.message || 'Reserva rechazada');
      reservado = true;
    } catch (err) {
      console.error(err);
    }

    if (reservado) {
      const msg = `Hola, solicito confirmación de mi cita. Nombre: ${nombre} ${apellidos}, Fecha: ${fmtLong(cita.fecha)}, Hora: ${fmt12(cita.hora)}`;
      const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(msg)}`;
      if (wa) wa.location.href = url;
      else window.location.href = url;
      slots = slots.filter((s) => !(s.fecha === cita.fecha && s.hora === cita.hora));
      selected = null;
      activeDay = '';
      form.reset();
      if (!slots.length) {
        slotsPicker.hidden = true;
        slotsState.hidden = false;
        slotsState.className = 'slots-state';
        slotsState.textContent = 'Ya no hay horarios disponibles. Contáctanos por WhatsApp para agendar.';
      } else {
        if (!slots.some((s) => monthKey(s.fecha) === activeMonth)) activeMonth = monthKey(slots[0].fecha);
        render();
      }
      showStatus('¡Horario reservado! Continúa tu confirmación en WhatsApp.', true);
    } else {
      wa?.close();
      showStatus('No se pudo reservar el horario. Es posible que ya no esté disponible; revisa la lista e inténtalo de nuevo.', false);
      loadSlots();
    }
    submitBtn.textContent = originalText;
    enableForm(reservado ? false : selected !== null);
  });

  const privacyDialog = $<HTMLDialogElement>('privacidad-modal');
  $('openPrivacy').addEventListener('click', (e) => {
    e.preventDefault();
    privacyDialog.showModal();
  });
  privacyDialog.querySelector('.privacy-close')?.addEventListener('click', () => privacyDialog.close());
  privacyDialog.addEventListener('click', (e) => { if (e.target === privacyDialog) privacyDialog.close(); });

  loadSlots();
</script>
